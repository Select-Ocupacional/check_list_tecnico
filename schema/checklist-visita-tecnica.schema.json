{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://select-ocupacional.com.br/schemas/checklist-visita-tecnica/1.9.0.json",
  "title": "Check-list de Visita Técnica (SST)",
  "description": "Contrato de dados da Visita Técnica de SST da Select Ocupacional. Fonte única de validação de integridade (SST-01).",
  "type": "object",
  "$comment": "versao_schema: 1.8.0. Historico: 1.1.0 removeu CPF; 1.2.0 removeu 'conforme' (SST-09) e +'avaliar' (SST-10); 1.3.0 +'funcoes' (SST-08); 1.4.0 +'quantificacao' (SST-11); 1.5.0 +'contatos' (SST-06); 1.6.0 +'ghes' (SST-12); 1.7.0 +'treinamentos' (SST-13); 1.8.0 moveu avaliacoes_risco/verificacoes_epi_epc do setor para a FUNCAO; 1.9.0 +indice/unidade no risco (agrupamento GHE por valor exato).",
  "required": [
    "id",
    "status",
    "data_visita",
    "hora_inicio",
    "cliente",
    "unidade",
    "tecnico",
    "setores",
    "assinaturas",
    "auditoria"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "codigo_visita": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["rascunho", "concluida", "sincronizada", "cancelada"]
    },
    "data_visita": { "type": "string", "format": "date" },
    "hora_inicio": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "hora_fim": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "cliente": { "$ref": "#/$defs/cliente" },
    "unidade": { "$ref": "#/$defs/unidade" },
    "tecnico": { "$ref": "#/$defs/tecnico" },
    "setores": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setorAvaliado" }
    },
    "ghes": {
      "type": "array",
      "$comment": "1.6.0 (SST-12): Grupos Homogeneos de Exposicao; cada GHE referencia ids de funcoes dos setores.",
      "items": { "$ref": "#/$defs/ghe" }
    },
    "treinamentos": {
      "type": "array",
      "$comment": "1.7.0 (SST-13): treinamentos por funcao, com situacao (possui/necessita reciclagem).",
      "items": { "$ref": "#/$defs/treinamento" }
    },
    "nao_conformidades": {
      "type": "array",
      "items": { "$ref": "#/$defs/naoConformidade" }
    },
    "assinaturas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assinatura" }
    },
    "observacoes_gerais": { "type": "string" },
    "auditoria": { "$ref": "#/$defs/metadadosAuditoria" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "UUID v4 gerado no dispositivo."
    },
    "datetimeIso": { "type": "string", "format": "date-time" },
    "endereco": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logradouro", "municipio", "uf"],
      "properties": {
        "logradouro": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "municipio": { "type": "string" },
        "uf": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "cep": { "type": "string", "pattern": "^[0-9]{8}$" }
      }
    },
    "cliente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["razao_social", "cnpj"],
      "properties": {
        "razao_social": { "type": "string", "minLength": 1 },
        "nome_fantasia": { "type": "string" },
        "cnpj": { "type": "string", "pattern": "^[0-9]{14}$" },
        "codigo_cliente_erp": { "type": "string" },
        "contatos": {
          "type": "array",
          "$comment": "1.5.0 (SST-06): multiplos contatos com email e departamento/funcao.",
          "items": { "$ref": "#/$defs/contato" }
        }
      }
    },
    "contato": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nome": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "departamento": { "type": "string" },
        "telefone": { "type": "string" }
      }
    },
    "unidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "endereco"],
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "endereco": { "$ref": "#/$defs/endereco" },
        "cnae_principal": { "type": "string" },
        "grau_risco": { "type": "integer", "enum": [1, 2, 3, 4] },
        "numero_trabalhadores": { "type": "integer", "minimum": 0 }
      }
    },
    "tecnico": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "funcao": { "type": "string" },
        "registro_profissional": { "type": "string" }
      }
    },
    "setorAvaliado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nome": { "type": "string", "minLength": 1 },
        "descricao": { "type": "string" },
        "funcoes": {
          "type": "array",
          "$comment": "1.3.0 (SST-08): funcoes do setor. 1.8.0: riscos/EPIs passam a ser por funcao.",
          "items": { "$ref": "#/$defs/funcaoSetor" }
        }
      }
    },
    "funcaoSetor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nome": { "type": "string", "minLength": 1 },
        "quantidade": { "type": "integer", "minimum": 0 },
        "avaliacoes_risco": {
          "type": "array",
          "$comment": "1.8.0: avaliacao de risco por funcao.",
          "items": { "$ref": "#/$defs/avaliacaoRisco" }
        },
        "verificacoes_epi_epc": {
          "type": "array",
          "$comment": "1.8.0: verificacao de EPI/EPC por funcao.",
          "items": { "$ref": "#/$defs/verificacaoEpiEpc" }
        }
      }
    },
    "ghe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nome": { "type": "string", "minLength": 1 },
        "descricao": { "type": "string" },
        "funcoes_ref": {
          "type": "array",
          "$comment": "Referências (ids) para FuncaoSetor cadastradas nos setores.",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      }
    },
    "treinamento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nome", "situacao"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nome": { "type": "string", "minLength": 1 },
        "situacao": {
          "type": "string",
          "enum": ["possui", "necessita_reciclagem", "nao_possui"]
        },
        "funcoes_ref": {
          "type": "array",
          "$comment": "Referências (ids) para FuncaoSetor às quais o treinamento se aplica.",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      }
    },
    "avaliacaoRisco": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grupo", "agente", "presente"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "grupo": {
          "type": "string",
          "enum": ["fisico", "quimico", "biologico", "ergonomico", "acidente"]
        },
        "agente": { "type": "string", "minLength": 1 },
        "fonte_geradora": { "type": "string" },
        "presente": { "type": "boolean" },
        "nivel_exposicao": {
          "type": "string",
          "$comment": "1.2.0 (SST-10) acrescentou 'avaliar' (requer quantificacao instrumental).",
          "enum": ["nao_avaliado", "baixo", "medio", "alto", "avaliar"]
        },
        "medidas_controle_existentes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["epc", "epi", "administrativa", "nenhuma"]
          },
          "uniqueItems": true
        },
        "observacao": { "type": "string" },
        "indice": {
          "type": "number",
          "minimum": 0,
          "$comment": "1.9.0: valor medido ou sabido do agente (ex.: 85 dB(A), 3.2 m/s2). Usado no agrupamento de GHE por valor exato para ruido continuo/intermitente, vibracoes e quimicos."
        },
        "unidade": {
          "type": "string",
          "$comment": "1.9.0: unidade do indice (ex.: dB(A), m/s2, mg/m3, ppm)."
        },
        "quantificacao": {
          "type": "object",
          "$comment": "1.4.0 (SST-11): registro da medicao instrumental do agente.",
          "additionalProperties": false,
          "properties": {
            "data": { "type": "string", "format": "date" },
            "hora": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "equipamento": { "type": "string" }
          }
        },
        "evidencias": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenciaFotografica" }
        }
      }
    },
    "verificacaoEpiEpc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo", "descricao", "conforme"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "tipo": { "type": "string", "enum": ["epi", "epc"] },
        "descricao": { "type": "string", "minLength": 1 },
        "numero_ca": { "type": "string" },
        "fornecido": { "type": "boolean" },
        "em_uso": { "type": "boolean" },
        "estado_conservacao": {
          "type": "string",
          "enum": ["bom", "regular", "ruim", "nao_aplicavel"]
        },
        "conforme": {
          "type": "string",
          "enum": ["conforme", "nao_conforme", "nao_aplicavel"]
        },
        "observacao": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "Regra 3: numero_ca obrigatorio para EPI.",
          "if": {
            "properties": { "tipo": { "const": "epi" } },
            "required": ["tipo"]
          },
          "then": { "required": ["numero_ca"] }
        }
      ]
    },
    "naoConformidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descricao", "gravidade", "recomendacao"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "descricao": { "type": "string", "minLength": 1 },
        "origem_ref": { "$ref": "#/$defs/uuid" },
        "gravidade": {
          "type": "string",
          "enum": ["baixa", "media", "alta", "critica"]
        },
        "norma_referencia": { "type": "string" },
        "recomendacao": { "type": "string", "minLength": 1 },
        "prazo_sugerido_dias": { "type": "integer", "minimum": 0 },
        "evidencias": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenciaFotografica" }
        }
      },
      "allOf": [
        {
          "$comment": "Regra 5: gravidade alta/critica exige ao menos uma evidencia fotografica.",
          "if": {
            "properties": {
              "gravidade": { "enum": ["alta", "critica"] }
            },
            "required": ["gravidade"]
          },
          "then": {
            "properties": {
              "evidencias": { "type": "array", "minItems": 1 }
            },
            "required": ["evidencias"]
          }
        }
      ]
    },
    "evidenciaFotografica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "arquivo_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "arquivo_ref": { "type": "string", "minLength": 1 },
        "legenda": { "type": "string" },
        "capturada_em": { "$ref": "#/$defs/datetimeIso" },
        "geolocalizacao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "assinatura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "papel", "nome", "assinatura_ref", "assinado_em"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "papel": { "type": "string", "enum": ["tecnico", "responsavel_empresa"] },
        "nome": { "type": "string", "minLength": 1 },
        "cargo": { "type": "string" },
        "assinatura_ref": { "type": "string", "minLength": 1 },
        "assinado_em": { "$ref": "#/$defs/datetimeIso" }
      }
    },
    "metadadosAuditoria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criado_em", "atualizado_em", "versao_schema"],
      "properties": {
        "criado_em": { "$ref": "#/$defs/datetimeIso" },
        "atualizado_em": { "$ref": "#/$defs/datetimeIso" },
        "sincronizado_em": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Nulo enquanto a visita nao foi sincronizada (offline-first)."
        },
        "dispositivo_id": { "type": "string" },
        "versao_app": { "type": "string" },
        "versao_schema": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
